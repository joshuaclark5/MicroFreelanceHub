{
  "expo": {
    "name": "MicroFreelanceHub",
    "slug": "microfreelancehub-mobile",
    "scheme": "microfreelancehub",
    "version": "0.1.4",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.microfreelancehub.mobile"
    },
    "android": {
      "package": "com.microfreelancehub.mobile",
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
